OPENAI_API_KEY=sk-proj-replace-me
OPENAI_MODEL=gpt-5.5
# Cheaper model for chat (headline reports stay on OPENAI_MODEL). A plain id
# (gpt-5-mini) goes to OpenAI; a "vendor/model" id (e.g. z-ai/glm-5.2) routes
# through OpenRouter using OPENROUTER_API_KEY.
CHAT_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
# Model for the headline reports (profile + clarity). Blank = OPENAI_MODEL (gpt-5.5).
# Set to z-ai/glm-5.2 to generate reports via OpenRouter (GLM 5.2).
REPORT_MODEL=

# New-account signups. CLOSED by default (safety guard while in test mode). Existing
# users always sign in. Set to true to OPEN signups at launch. For an authoritative
# backstop against OAuth/magic-link auto-create, also disable signups in the Supabase
# dashboard (Authentication → Sign In / Providers → Allow new users to sign up).
NEXT_PUBLIC_ALLOW_SIGNUPS=

# Supabase (Phase 1: accounts) — Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client or commit. Used by webhooks / admin / migration.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 3) — TEST MODE keys only for now (sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect (Direct Charges, Standard). STRIPE_CONNECTED_ACCOUNT_ID = Samuel's
# connected account (acct_…), the merchant of record. Ascendance (platform) keeps
# APPLICATION_FEE_PERCENT of each subscription. 50 = a 50/50 split.
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_APPLICATION_FEE_PERCENT=50
