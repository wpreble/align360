OPENAI_API_KEY=sk-proj-replace-me
OPENAI_MODEL=gpt-5.5
# Cheaper model for chat (headline reports stay on OPENAI_MODEL). A plain id
# (gpt-5-mini) goes to OpenAI; a "vendor/model" id (e.g. z-ai/glm-5.2) routes
# through OpenRouter using OPENROUTER_API_KEY.
CHAT_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
# Model for the headline reports (profile + clarity). Blank = OPENAI_MODEL (gpt-5.5).
# Set to z-ai/glm-5.2 to generate reports via OpenRouter (GLM 5.2).
REPORT_MODEL=

# Supabase (Phase 1: accounts) — Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client or commit. Used by webhooks / admin / migration.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Phase 3). LOCAL DEV: keep TEST keys here (sk_test_… / pk_test_…).
# PRODUCTION (go-live sanctioned 2026-07-01): set LIVE keys in Vercel only, never
# in this repo. Live needs all of: STRIPE_SECRET_KEY (sk_live_),
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_live_), STRIPE_WEBHOOK_SECRET (whsec_ from
# the LIVE webhook endpoint pointing at /api/stripe/webhook), and the live
# products created via scripts/stripe-setup-products.ts --live --confirm.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Connect (Direct Charges, Standard). STRIPE_CONNECTED_ACCOUNT_ID = Samuel's
# connected account (acct_…), the merchant of record. Ascendance (platform) keeps
# APPLICATION_FEE_PERCENT of each subscription. 50 = a 50/50 split.
STRIPE_CONNECTED_ACCOUNT_ID=
STRIPE_APPLICATION_FEE_PERCENT=50

# Admin dashboard (/admin) — dedicated auth, separate from the app's user accounts.
# ADMIN_USERS: JSON array of {email,salt,hash} (scrypt; salt+hash are hex). Provisioned
# out-of-band; never commit real values. ADMIN_SESSION_SECRET: random 32-byte hex that
# signs the admin session cookie.
ADMIN_USERS=
ADMIN_SESSION_SECRET=
